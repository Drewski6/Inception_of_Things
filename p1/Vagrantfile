Vagrant.configure("2") do |config|

  config.vm.box = "generic/ubuntu2310"
  config.vm.box_version = "4.3.12"

  config.vm.define "dpentlanS" do |control|
    control.vm.hostname = "dpentlanS"
    control.vm.network "private_network", ip: "192.168.56.110" # may have to change to public_network if you need to connect to apps running inside these VMs.
    control.vm.provider :libvirt do |libvirt|
      libvirt.driver = "kvm"
      libvirt.memory = 512
      libvirt.cpus = 1
    end
    control.vm.provision "shell", inline: <<-SHELL # note that I changed this to control.vm.etc from config.vm.etc from the subject. config seems like it would be global for me. so I dont know why we would use it inisde this block so I changed it. But if this doesn't work in the future, come back and change this.
      echo "hello world"
    SHELL
    # control.vm.provision "shell", path: REDACTED
  end

  config.vm.define "dpentlanSW" do |control|
    control.vm.hostname = "dpentlanSW"
    control.vm.network "private_network", ip: "192.168.56.111"
    control.vm.provider :libvirt do |libvirt|
      libvirt.driver = "kvm"
      libvirt.memory = 512
      libvirt.cpus = 1
    end
  end

end
